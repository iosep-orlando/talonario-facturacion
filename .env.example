# Copiá este fichero a .env.local y completalo. .env.local no se sube al repo.
# Son las variables del enunciado, más alguna opcional.

# MongoDB. Si ya tenés uno en el 27017 (de otro proyecto), usá su cadena:
# esta app usa su propia base ("saas_facturacion").
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=saas_facturacion

# RustFS (S3) para los PDF y los logos. AWS_URL es la API S3 (no la consola).
# El bucket se crea solo si no existe.
AWS_USERNAME=rustfsadmin
AWS_PASSWORD=rustfsadmin
AWS_REGION=us-east-1
AWS_URL=http://localhost:9001
# AWS_BUCKET=saas-facturacion

# Correo en desarrollo: MailHog. Los mails no salen: se ven en
# http://localhost:8025
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# Firma de las sesiones. En desarrollo es opcional (hay una fija); en
# producción es obligatoria: openssl rand -base64 32
# JWT_SECRET=

# El usuario de los datos de ejemplo (npx tsx scripts/seed.ts). Si no está,
# demo@talonario.test.
# SEED_OWNER_EMAIL=tu-email@ejemplo.com
